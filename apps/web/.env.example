# Web (Vite) environment variables
# Copy to .env.local for local overrides.

# API base URL
# - Leave empty to use same-origin (recommended in local dev with Vite proxy).
# - Set to an absolute URL in production when frontend and backend are hosted separately.
VITE_API_BASE_URL=
VITE_PAYSTACK_PUBLIC_KEY=
VITE_TINGG_ENV=sandbox
VITE_TINGG_SCRIPT_URL=https://cdn.cellulant.africa/js/tingg-checkout-library.js

# API prefix for most REST endpoints (default is /api/v1)
VITE_API_PREFIX=/api/v1

# Optional default channel code hint
# - If set, the web app will try this channel first when resolving the default storefront channel.
# - If unset, it will fall back to the first public channel.
VITE_DEFAULT_CHANNEL_CODE=WEB

# Vite dev-server proxy target (only used in dev)
# Proxies /api/* and /auth/* to this backend target.
VITE_API_PROXY_TARGET=http://localhost:8090
