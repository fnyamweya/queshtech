# App Config
APP_NAME=qtech-apis
SUPER_ADMIN_EMAIL=superadmin@example.com
APP_URL=http://localhost:5000
PASSWORD_SET_PATH=/auth/password-set

# Optional: if you have separate customer/admin frontends, set these.
# If left empty, the system falls back to APP_URL + PASSWORD_SET_PATH.
CUSTOMER_APP_URL=
CUSTOMER_PASSWORD_SET_PATH=
ADMIN_APP_URL=
ADMIN_PASSWORD_SET_PATH=

# Optional (highest priority): per-role routing.
# Format: ROLE_<ROLE_NAME>_APP_URL and ROLE_<ROLE_NAME>_PASSWORD_SET_PATH
# ROLE_NAME is uppercased and non-alphanumerics become underscores.
# Example role name "axis" => ROLE_AXIS_APP_URL
ROLE_ADMIN_APP_URL=
ROLE_ADMIN_PASSWORD_SET_PATH=
PORT=8090

# Optional runtime toggles
# Enable swagger explicitly in production if desired.
SWAGGER_ENABLED=false

# Outbound HTTP client defaults (used by ApiClientService)
HTTP_TIMEOUT_MS=30000

# Upload staging directory (used by common upload controller)
UPLOAD_STAGING_DIR=/tmp/qtech-uploads

# Disable all outbound email sending (useful for local dev)
EMAIL_DISABLED=true

# Encryption (used for storing secrets in settings)
ENCRYPTION_KEY=

# Password Hashing (Argon2id)
ARGON2_MEMORY_COST=19456
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=1
ARGON2_HASH_LENGTH=32
ARGON2_SALT_LENGTH=16

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=postgres
DB_NAME=nestjs_typeorm_postgres_db

# TypeORM / DB runtime flags
# - DB_SYNC=true uses TypeORM synchronize (useful for local dev only)
# - DB_MIGRATIONS_RUN=false prevents auto-running migrations at startup
# - DB_SSL defaults to true for non-local DB hosts; set explicitly as needed
DB_SYNC=false
DB_MIGRATIONS_RUN=true
DB_SSL=false
NODE_ENV=development

# Redis Configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_DB=0
REDIS_TLS=false

# JWT Configuration
JWT_SECRET=74db5010c1cd2989e21f49160e22e014b51625097bb721535c529de2cb97f58d
JWT_EXPIRATION=5m
JWT_REFRESH_SECRET=59292b190434a15524d53f2e03df1a5f961d5852ee9ed42b9a4c5f8601b80a81
JWT_REFRESH_EXPIRATION=7d
USER_INVITE_URL=https://example.com/invite
USER_INVITE_EXPIRY_DAYS=7

# AWS S3 Configuration
AWS_ACCESS_KEY_ID=<AWS_ACCESS_KEY_ID>
AWS_SECRET_ACCESS_KEY=<AWS_SECRET_ACCESS_KEY>
AWS_REGION=<AWS_REGION>
AWS_BUCKET_NAME=<AWS_BUCKET_NAME>

# Email Configuration
EMAIL_FROM_NAME="qtech-apis"

# Mpesa Daraja Configuration
# Set MPESA_DARAJA_ENV to 'sandbox' for testing, 'production' for live.
MPESA_DARAJA_ENV=sandbox
MPESA_DARAJA_CONSUMER_KEY=fxbMjOYvmaJPbnYmm1El3m4Kd0iFqflAMDGQ8GGZAu8Ardsa
MPESA_DARAJA_CONSUMER_SECRET=Xh10kS5HC4NxHzdDzCiVdsJBGJHhbSUVIdEbNhFsenAJ75FBMgroUtGuUJUpFYGS
MPESA_DARAJA_SHORTCODE=174379

# Required for STK Push
MPESA_DARAJA_PASSKEY=

# Required for B2C/B2B
MPESA_DARAJA_INITIATOR_NAME=
# SecurityCredential should be the already-encrypted initiator password (Daraja requirement)
MPESA_DARAJA_SECURITY_CREDENTIAL=

# Must be publicly reachable by Safaricom (use ngrok in dev)
MPESA_DARAJA_CALLBACK_BASE_URL=

# Paystack
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_CALLBACK_URL=
PAYSTACK_WEBHOOK_URL=

# Tingg (Cellulant)
TINGG_ENV=sandbox
TINGG_API_KEY=
TINGG_CLIENT_ID=
TINGG_CLIENT_SECRET=
TINGG_SERVICE_CODE=
TINGG_CALLBACK_URL=
TINGG_SUCCESS_REDIRECT_URL=
TINGG_FAIL_REDIRECT_URL=

# WhatsApp Business (Meta) Configuration (optional fallback to env)
# WHATSAPP_ACCESS_TOKEN + WHATSAPP_BUSINESS_ACCOUNT_ID required for template list/submit.
# WHATSAPP_PHONE_NUMBER_ID required for sending messages.
WHATSAPP_PROVIDER=meta
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_APP_ID=
WHATSAPP_API_VERSION=v19.0
WHATSAPP_BASE_URL=https://graph.facebook.com
WHATSAPP_ENABLED=false
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# Apple OAuth env fallback (optional; primary config comes from Settings UI)
APPLE_CLIENT_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
APPLE_CALLBACK_URL=
# If setting a multi-line key in env, use literal \n sequences.
APPLE_PRIVATE_KEY=
